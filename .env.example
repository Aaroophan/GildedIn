# SAFE EXAMPLE ONLY - never commit a populated .env.local, never paste real credentials.
# Local fake adapters; all optional features disabled by default.
APP_ENV=local
APP_CANONICAL_ORIGIN=http://localhost:3000
APP_DOMAIN=localhost
APP_WILDCARD_ENABLED=false
APP_WILDCARD_TLS_VERIFIED=false
APP_ZERO_CHARGE_APPROVED=false
MONGODB_DB=gildedin_local
MEDIA_PROVIDER=memory
FEATURE_AI_PLATFORM=off
FEATURE_UPLOADS_PLATFORM=off
FEATURE_RSS_SYNC=off
FEATURE_REGISTRATION=off
AI_GLOBAL_MESSAGE_LIMIT=100
MEDIA_GLOBAL_SAFE_BYTES=15728640
AUDIT_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30
# No provider secrets or production URLs belong in this template.

# Optional OAuth config ONLY after an explicit reviewed local adapter setup:
# AUTH_URL=http://localhost:3000
# AUTH_SECRET=<inject-from-operator-secret-manager-minimum-43-chars>
# AUTH_GOOGLE_ID=<google-client-id>
# AUTH_GOOGLE_SECRET=<google-client-secret>
# AUTH_GITHUB_ID=<github-client-id>
# AUTH_GITHUB_SECRET=<github-client-secret>
# MONGODB_URI=mongodb://127.0.0.1:27017/gildedin_local
# When real provider setup is proven, set FEATURE_REGISTRATION=on locally only.

{
  "compilerOptions": {
    "target":"ES2022",
    "lib":["ES2022","DOM"],
    "module":"ESNext",
    "moduleResolution":"Bundler",
    "allowImportingTsExtensions":true,
    "strict":true,
    "skipLibCheck":true,
    "noEmit":true,
    "types":["node"]
  },
  "include":["src/server/**/*.ts","src/testing/**/*.ts","src/shared/**/*.ts"]
}

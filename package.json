{
  "name": "gildedin",
  "version": "0.1.0",
  "private": true,
  "description": "GildedIn - specification-led modular-monolith foundation (Issue 1)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:domain": "tsc --noEmit -p tsconfig.domain.json",
    "test:domain": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "check:requirements": "node --experimental-strip-types scripts/check-requirements.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify:foundation": "npm run check:requirements && npm run check:boundaries && npm run check:secrets && npm run test:domain && npm run typecheck:domain"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.6",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "type": "module"
}
